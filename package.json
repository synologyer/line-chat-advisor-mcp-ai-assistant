{
  "name": "claude-line-readonly",
  "version": "0.3.0",
  "description": "Claude Desktop read-only connector for an explicitly configured local LINE account on macOS.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/synologyer/line-chat-advisor-mcp-ai-assistant.git"
  },
  "type": "module",
  "scripts": {
    "start": "node src/line-readonly-mcp/server.mjs",
    "test": "node --test tests/*.test.mjs && .venv/bin/python3 -m unittest discover -s tests -p 'test_*.py'",
    "doctor": "scripts/doctor",
    "check:package": "node scripts/check-package.mjs",
    "prepublishOnly": "npm test && npm run check:package"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "3.25.76"
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "homepage": "https://github.com/synologyer/line-chat-advisor-mcp-ai-assistant#readme",
  "bugs": {
    "url": "https://github.com/synologyer/line-chat-advisor-mcp-ai-assistant/issues"
  },
  "files": [
    "src/line-readonly-mcp/*.mjs",
    "src/line-readonly-mcp/*.py",
    "src/key-capture/*.py",
    "src/key-capture/*.swift",
    "src/key-capture/*.plist",
    "tests/*.mjs",
    "tests/*.py",
    "requirements.lock",
    "LICENSE",
    "bin/*.mjs",
    "npm-shrinkwrap.json",
    "README.md",
    "INSTALL.md",
    "MAINTAINERS.md",
    "SECURITY.md",
    "PRIVACY.md",
    "AUDIT.md",
    "VENDOR_LOCK.md",
    "ACCEPTANCE.md",
    "requirements-attachments.in",
    "requirements-attachments.lock",
    "src/line-readonly-mcp/*.swift",
    "HISTORY-UI-TROUBLESHOOTING.md",
    "docs/*.md",
    "AGENTS.md",
    "scripts/*.py",
    "scripts/*.mjs",
    "scripts/bootstrap",
    "scripts/bootstrap-vendors",
    "scripts/doctor",
    "scripts/build-keychain-helper",
    "scripts/build-history-helper",
    "scripts/build-peekaboo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "line-context-relay": "bin/line-context-relay.mjs"
  },
  "private": true
}
